// Fuente de verdad textual: 02_Documento_Tecnico_Guia.docx (sección 4)
// Cualquier cambio de modelo se documenta primero allá y luego se refleja aquí.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────

enum StockMovementType {
  RESTOCK    // entrada
  SALE       // salida por venta
  ADJUSTMENT // ajuste manual
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ── Entidades ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products            Product[]
  sales               Sale[]
  expenses            Expense[]
  chatSessions        ChatSession[]
  passwordResetTokens PasswordResetToken[]
  stockMovements      StockMovement[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Product {
  id        String    @id @default(cuid())
  name      String
  price     Decimal   @db.Decimal(12, 2)
  cost      Decimal   @db.Decimal(12, 2)
  stock     Int       @default(0) // valor cacheado; se actualiza junto con StockMovement en la misma transacción
  minStock  Int       @default(0)
  deletedAt DateTime? // soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([userId, deletedAt])
  @@map("products")
}

model StockMovement {
  id        String            @id @default(cuid())
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Enlace opcional: el movimiento tipo SALE queda ligado a la línea de venta que lo generó
  saleItemId String?    @unique
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id])

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id        String   @id @default(cuid())
  total     Decimal  @db.Decimal(12, 2)
  saleDate  DateTime @default(now())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items SaleItem[]

  @@index([userId, saleDate])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) // congelado al momento de la venta
  unitCost  Decimal @db.Decimal(12, 2) // congelado al momento de la venta

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  stockMovement StockMovement?

  @@map("sale_items")
}

model Expense {
  id          String   @id @default(cuid())
  concept     String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expenseDate])
  @@map("expenses")
}

model ChatSession {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(cuid())
  role       ChatRole
  content    String
  toolCalls  Json?    // reconstrucción exacta del contexto de tools
  toolCallId String?
  createdAt  DateTime @default(now())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
